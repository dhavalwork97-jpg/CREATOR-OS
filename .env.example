# Owner authentication (Neon Auth)
# Set this to the one email address allowed to access Creator OS.
OWNER_EMAIL=

# Protects the scheduled worker endpoint. Use a random value of at least 32 characters.
CRON_SECRET=

# Instagram direct API (optional; Creator account supported with correct Meta app permissions)
IG_GRAPH_API_VERSION=vXX.X
IG_USER_ID=
IG_ACCESS_TOKEN=

# Zapier publishing bridge (preferred for your linked Creator account)
# Create a Zap: Webhooks by Zapier > Catch Hook -> Instagram for Business publish action -> Webhooks by Zapier POST callback.
ZAPIER_PUBLISH_WEBHOOK_URL=
# Public HTTPS base URL where Creator OS is deployed, e.g. https://your-app.example.com
CREATOR_OS_PUBLIC_URL=
# Long random secret. Configure the same value as X-Creator-OS-Callback-Secret header in Zapier's callback step.
ZAPIER_CALLBACK_SECRET=

# Keep false until webhook, callback, authentication and test publishing are verified.
ENABLE_AUTOPUBLISH=false
AUTOPUBLISH_POLL_MS=30000
MAX_POSTS_PER_DAY=3
MIN_MINUTES_BETWEEN_POSTS=180
PORT=3000
