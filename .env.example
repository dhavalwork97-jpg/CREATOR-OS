# Owner authentication (Neon Auth)
# Set this to the one email address allowed to access Creator OS.
OWNER_EMAIL=
# Temporary one-time code required to create the first owner account; remove after signup.
OWNER_SETUP_SECRET=

# Protects the scheduled worker endpoint. Use a random value of at least 32 characters.
CRON_SECRET=

# Instagram publishing via the official Meta Graph API
IG_GRAPH_API_VERSION=vXX.X
IG_USER_ID=
IG_ACCESS_TOKEN=

# Keep false until webhook, callback, authentication and test publishing are verified.
ENABLE_AUTOPUBLISH=false
MAX_POSTS_PER_DAY=3
MIN_MINUTES_BETWEEN_POSTS=180

# Posting schedule. Hours are 0-23 in your local time; the offset is minutes east of UTC
# (330 = UTC+05:30, the default). Slots are suggested/assigned from these hours.
POSTING_HOURS=12,19
POSTING_UTC_OFFSET_MINUTES=330
PORT=3000

# Gemini API key (server-side only). Used by the text provider and the optional image provider.
GEMINI_API_KEY=

# Gemini TEXT generation (free tier). Opt-in: nothing is called until this is "true".
# IMPORTANT: create the API key in a Google project that has NO billing enabled. Then hitting the
# free-tier limit gives an error instead of a charge. Free-tier prompts may be used by Google to improve its products.
GEMINI_TEXT_ENABLED=false
# Optional. Leave unset to follow Google's current lightweight Flash model; you can also pick one in the dashboard.
GEMINI_TEXT_MODEL=
MAX_TEXT_GENERATIONS_PER_DAY=20

GEMINI_IMAGE_GENERATION_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
MAX_IMAGE_GENERATIONS_PER_DAY=2
# Image generation is treated as PAID. Set your own estimate so the dashboard can show it before you confirm.
# Set GEMINI_IMAGE_FREE_TIER=true only if you have verified the model is free for your key.
GEMINI_IMAGE_COST_USD_PER_IMAGE=
GEMINI_IMAGE_FREE_TIER=false

# Media storage for files you upload on the content board (Cloudinary, free plan: no payment details needed).
# Instagram fetches media from a public HTTPS URL; Cloudinary serves your uploads from res.cloudinary.com.
# Find these in the Cloudinary dashboard (Settings > API Keys). Keep the secret server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Limits that keep you well inside the free plan (25 monthly credits; 1 GB of storage = 1 credit).
STORAGE_MAX_TOTAL_MB=3000
STORAGE_MAX_UPLOADS_PER_DAY=20
STORAGE_MAX_IMAGE_MB=8
STORAGE_MAX_VIDEO_MB=100
