# Instagram professional account + Meta app credentials
IG_GRAPH_API_VERSION=vXX.X
IG_USER_ID=
IG_ACCESS_TOKEN=

# Keep disabled until the Meta connection has been tested
ENABLE_AUTOPUBLISH=false
AUTOPUBLISH_POLL_MS=30000
MAX_POSTS_PER_DAY=3
MIN_MINUTES_BETWEEN_POSTS=180
PORT=3000

# Optional: Make.com webhook endpoint for publishing via a Make scenario
MAKE_PUBLISH_WEBHOOK_URL=